<Window x:Class="GasGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GasGuard Desktop — Gas Detection System Using GSM"
        Icon="Assets/GasGuard.ico"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,22,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="GG" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="14" Foreground="#07181B" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GASGUARD" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Desktop monitoring" Style="{StaticResource SubtleText}" FontSize="10.5" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,7" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="GAS DETECTION" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="GSM SMS monitoring" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Grid.Row="1" Style="{StaticResource NavListBox}"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0,0,0"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16,10,16,18">
                    <Border CornerRadius="8" BorderThickness="1" Padding="11">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulatedMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding ModeLabel}" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimulatedMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Demo values are not live safety data." Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                                       Visibility="{Binding IsSimulatedMode, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Hardware values still require freshness checks." Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                                       Visibility="{Binding IsSimulatedMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AppVersion, StringFormat=GasGuard Desktop v{0}}" Style="{StaticResource SubtleText}" Margin="2,10,0,0" />
                    <TextBlock Text="Africa/Lagos display time" Style="{StaticResource SubtleText}" Margin="2,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource AppBackgroundBrush}">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Gas detection / GSM SMS operations" Style="{StaticResource SubtleText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,12,0" Padding="10,6">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PillBorder}">
                                    <Setter Property="Background" Value="{StaticResource MutedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOpenWarnings}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasOpenCritical}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CriticalSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="UNRESOLVED" FontSize="8.5" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOpenWarnings}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasOpenCritical}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding OpenAlertsSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PillBorder}" Margin="0,0,14,0" Padding="10,6"
                                Background="{Binding ModemConnectionState, Converter={StaticResource StateBrush}, ConverterParameter=background}">
                            <StackPanel>
                                <TextBlock Text="{Binding ModemStatusText}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding ModemConnectionState, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{Binding ModemStatusDetail}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="330" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LagosClock}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{Binding NotificationSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=background}"
                    BorderBrush="{Binding NotificationSeverity, Converter={StaticResource SeverityBrush}}"
                    BorderThickness="1"
                    Margin="20,12,20,0"
                    CornerRadius="8"
                    Padding="12,10"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PillBorder}" Background="{Binding NotificationSeverity, Converter={StaticResource SeverityBrush}}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding NotificationSeverity, Converter={StaticResource StateText}}" FontSize="10" FontWeight="Bold"
                                   Foreground="#0D1620" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NotificationTitle}" FontWeight="SemiBold" />
                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                    Visibility="{Binding NotificationIsSimulated, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="SIMULATED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding NotificationMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding NotificationTimeText}" Style="{StaticResource SubtleText}" FontSize="10.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Review alerts" Style="{StaticResource SecondaryButton}" Command="{Binding ReviewNotificationCommand}" />
                        <Button Content="Dismiss" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding DismissNotificationCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="20,14,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,0,10"
                        Visibility="{Binding HasInitializationError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding InitializationError}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

                <Border Grid.RowSpan="2" Background="#D90D1620"
                        Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                        <ProgressBar IsIndeterminate="True" Height="5" />
                        <TextBlock Text="Starting GasGuard Desktop…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="Opening the local database and preparing the monitoring workspace." Style="{StaticResource SubtleText}"
                                   TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.RowSpan="2" Background="#E60D1620"
                        Visibility="{Binding IsMaintenanceActive, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                        <ProgressBar IsIndeterminate="True" Height="5" />
                        <TextBlock Text="Maintenance operation in progress" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="{Binding MaintenanceDescription}" Style="{StaticResource MutedText}"
                                   TextAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Monitoring input is paused. Do not close or power off the computer until this completes."
                                   Style="{StaticResource SubtleText}" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
