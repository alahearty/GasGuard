<Window x:Class="GasGuard.Desktop.Dialogs.DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GasGuard.Desktop.Converters"
        Title="Detector"
        Width="660"
        Height="720"
        MinWidth="620"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <conv:SpacedEnumConverter x:Key="SpacedEnumConverter" />
    </Window.Resources>
    <Grid Margin="18">
        <Border Style="{StaticResource CardBorder}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding DialogHeading}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Detector codes and expected sender numbers must be unique. Records are never hard-deleted."
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="Device code" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DeviceCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Text="Installation location" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InstallationLocation, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="Expected sender (SMS)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExpectedSenderNumber, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Nigerian mobile number, for example 0803 123 4567 or +234 803 123 4567" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Detector type" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DetectorTypes}" SelectedItem="{Binding DetectorType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SpacedEnumConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="Installation date (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InstallationDateText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14" VerticalAlignment="Bottom">
                            <CheckBox Content="Detector is active" IsChecked="{Binding IsActive}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MaxLength="1000" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Text="Maintenance notes" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaintenanceNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MaxLength="2000" />
                        </StackPanel>

                        <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="{DynamicResource CriticalSoftBrush}"
                                BorderBrush="{DynamicResource CriticalBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="96" Command="{Binding CancelCommand}" />
                    <Button Content="Save detector" Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="10,0,0,0" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
