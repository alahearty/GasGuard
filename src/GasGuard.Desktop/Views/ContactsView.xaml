<UserControl x:Class="GasGuard.Desktop.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.6*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Contacts &amp; Notifications" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Nigerian mobile contacts, notification preferences and outgoing SMS audit. A successful send means modem submission only; delivery is never claimed without evidence." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,4,0,0">
                <Button Content="Add contact" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding EditCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="{Binding ToggleActiveText}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource InsetBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Search contacts" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name, phone number or role" />
                </StackPanel>
                <CheckBox Grid.Column="2" Content="Include inactive contacts" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                <TextBlock Grid.Column="3" Text="{Binding FilteredCountText}" Style="{StaticResource SubtleText}" VerticalAlignment="Bottom" Margin="12,0,2,8" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <DataGrid ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}"
                              Visibility="{Binding HasContacts, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="1.4*" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumberDisplay}" Width="1.2*" />
                            <DataGridTextColumn Header="Role" Binding="{Binding Role, Converter={StaticResource SpacedEnum}}" Width="1*" />
                            <DataGridTemplateColumn Header="Active" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PillBorder}" Background="{Binding IsActive, Converter={StaticResource BoolToActiveBrush}, ConverterParameter=background}">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveText}}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToActiveBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Preferences" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource CriticalSoftBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,3,0"
                                                    Visibility="{Binding NotifyOnCritical, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="CRITICAL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,3,0"
                                                    Visibility="{Binding NotifyOnWarning, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="WARNING" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="3" Padding="4,1"
                                                    Visibility="{Binding NotifyOnCommunicationFailure, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="COMM" FontSize="8" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding HasContacts, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                        <TextBlock Text="No contacts" Style="{StaticResource EmptyStateTitle}" />
                        <TextBlock Text="Add a contact to receive optional automatic notifications and to send confirmed test messages." Style="{StaticResource EmptyStateBody}" />
                        <Button Content="Add contact" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Command="{Binding AddCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Confirmed test SMS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Select a contact, review, then confirm." Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                        <Border Style="{StaticResource InsetBorder}" Margin="0,10,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Recipient" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SelectedContact.FullName, TargetNullValue=No contact selected}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedContact.PhoneNumberDisplay}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="Inactive" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,3,0,0"
                                           Visibility="{Binding SelectedContactIsInactive, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Message" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding TestMessage, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="64" MaxLength="160" VerticalScrollBarVisibility="Auto"
                                 ToolTip="Printable ASCII only, maximum 160 characters." />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding TestRemainingText}" Style="{StaticResource SubtleText}" />
                        </Grid>
                        <Button Content="Send test SMS" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding SendTestMessageCommand}" IsEnabled="{Binding CanSendTest}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,10">
            <TextBlock Text="Outgoing SMS logs" Style="{StaticResource SectionTitle}" />
            <Button Content="Refresh logs" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    Command="{Binding RefreshLogsCommand}" />
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <DataGrid ItemsSource="{Binding OutgoingLogs}"
                          Visibility="{Binding HasOutgoingLogs, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time (Lagos)" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLagos}}" Width="1.2*" />
                        <DataGridTextColumn Header="Recipient" Binding="{Binding RecipientNumber}" Width="1.1*" />
                        <DataGridTemplateColumn Header="Outcome" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PillBorder}" Background="{Binding Outcome, Converter={StaticResource CommunicationOutcomeBrush}, ConverterParameter=background}">
                                        <TextBlock Text="{Binding Outcome, Converter={StaticResource SpacedEnum}}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding Outcome, Converter={StaticResource CommunicationOutcomeBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="1.5*" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
                        <DataGridTextColumn Header="Modem reference" Binding="{Binding ProviderReference}" Width="1*" />
                        <DataGridTemplateColumn Header="Demo" Width="0.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"
                                               Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel VerticalAlignment="Center" Margin="24"
                            Visibility="{Binding HasOutgoingLogs, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                    <TextBlock Text="No outgoing SMS attempts" Style="{StaticResource EmptyStateTitle}" />
                    <TextBlock Text="Operator-confirmed test messages and bounded automatic notification attempts are logged here." Style="{StaticResource EmptyStateBody}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
