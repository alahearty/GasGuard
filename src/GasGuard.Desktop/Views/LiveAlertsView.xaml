<UserControl x:Class="GasGuard.Desktop.Views.LiveAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Live Alerts" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Unresolved incidents remain here until an operator explicitly resolves them. Acknowledgement and a later NORMAL SMS do not clear a hazard." />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="18,4,0,0"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Unresolved incidents" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Select an incident to inspect or act" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleText}" />
                    </Grid>
                    <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Alerts}"
                              SelectedItem="{Binding SelectedAlert}"
                              Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PillBorder}" Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=background}">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource StateText}}" FontWeight="Bold" FontSize="10"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detector" Binding="{Binding DeviceCode}" Width="0.8*" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.5*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource IncidentStatusText}}" Width="1*" />
                            <DataGridTextColumn Header="Received (Lagos)" Binding="{Binding ReceivedAtUtc, Converter={StaticResource UtcToLagos}}" Width="1.4*" />
                            <DataGridTemplateColumn Header="Demo" Width="0.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"
                                                   Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="24" VerticalAlignment="Center"
                                Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                        <TextBlock Text="No unresolved incidents" Style="{StaticResource EmptyStateTitle}" />
                        <TextBlock Style="{StaticResource EmptyStateBody}"
                                   Text="This list only contains incidents that were received and not explicitly resolved. An empty list does not prove that any site is currently safe; check detector freshness on the dashboard." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailsHeading}" Style="{StaticResource SectionTitle}" FontSize="18" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource PillBorder}" Background="{Binding SelectedDetails.Summary.Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=background}">
                                            <TextBlock Text="{Binding SelectedDetails.Summary.Severity, Converter={StaticResource StateText}}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding SelectedDetails.Summary.Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                        <Border Style="{StaticResource PillBorder}" Margin="6,0,0,0" Background="{Binding SelectedDetails.Summary.Status, Converter={StaticResource IncidentStatusBrush}, ConverterParameter=background}">
                                            <TextBlock Text="{Binding SelectedDetails.Summary.Status, Converter={StaticResource IncidentStatusText}}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding SelectedDetails.Summary.Status, Converter={StaticResource IncidentStatusBrush}}" />
                                        </Border>
                                        <Border Style="{StaticResource PillBorder}" Margin="6,0,0,0" Background="{StaticResource InfoSoftBrush}"
                                                Visibility="{Binding SelectedDetails.Summary.IsSimulated, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="SIMULATED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Location" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.Location}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Device" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.DeviceName}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Occurred (Lagos)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.OccurredAtUtc, Converter={StaticResource UtcToLagos}}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.OccurredTimeSource, Converter={StaticResource SpacedEnum}}" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Received (Lagos)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.ReceivedAtUtc, Converter={StaticResource UtcToLagos}}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.ReceivedAtUtc, Converter={StaticResource UtcAge}, StringFormat=Receipt: {0}}" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Raw reading" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.Reading, StringFormat={}{0}}" FontWeight="SemiBold" />
                                    <TextBlock Text="Device-reported value; do not assume calibrated ppm." Style="{StaticResource SubtleText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Sequence" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.SequenceNumber}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Sender / parsing" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.SenderNumberRaw, StringFormat=Sender: {0}}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding SelectedDetails.SmsProcessingStatus, Converter={StaticResource SpacedEnum}, StringFormat=SMS processing status: {0}}" Style="{StaticResource SubtleText}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource InsetBorder}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Original SMS (preserved exactly as received)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedDetails.RawSmsBody}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="70" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InsetBorder}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Acknowledgement" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding AcknowledgementSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="During the open stage" Style="{StaticResource SubtleText}" Margin="0,12,0,4"
                                               Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Text="{Binding AcknowledgementNotes, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="54" MaxLength="2000"
                                             Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}"
                                             ToolTip="Optional note. Acknowledgement does not mean the hazard has cleared." />
                                    <Button Content="Acknowledge incident" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Command="{Binding AcknowledgeCommand}"
                                            IsEnabled="{Binding CanAcknowledge}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InsetBorder}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ResolutionSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="Resolution notes are required" Style="{StaticResource SubtleText}" Margin="0,12,0,4"
                                               Visibility="{Binding CanResolve, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Text="{Binding ResolutionNotes, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="64" MaxLength="2000"
                                             Visibility="{Binding CanResolve, Converter={StaticResource BoolToVisibility}}"
                                             ToolTip="Record the verification, corrective action and reason the incident is being closed." />
                                    <Button Content="Resolve incident" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Command="{Binding ResolveCommand}"
                                            IsEnabled="{Binding CanResolve}" />
                                    <TextBlock Text="A later NORMAL SMS never resolves this incident automatically." Style="{StaticResource SubtleText}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Incident history" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding TimestampUtc, Converter={StaticResource UtcToLagos}}" HorizontalAlignment="Right" Style="{StaticResource SubtleText}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Actor, StringFormat=Actor: {0}}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                        <TextBlock Text="Select an incident" Style="{StaticResource EmptyStateTitle}" />
                        <TextBlock Text="Choose an unresolved incident from the list to inspect the original SMS, acknowledgement state and full history." Style="{StaticResource EmptyStateBody}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
