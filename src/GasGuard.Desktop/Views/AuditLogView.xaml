<UserControl x:Class="GasGuard.Desktop.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Audit Log" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Configuration changes, operator decisions, report exports, backups and security-relevant rejections. Secrets and SIM credentials are not logged." />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="18,4,0,0"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource InsetBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Search details, actor, entity" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Action contains" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Outcome" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding SelectedOutcome}" DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="From (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FromDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="8">
                    <TextBlock Text="To (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ToDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Column="9" Content="Apply" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="12,0,0,0"
                        Command="{Binding ApplyFiltersCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding Entries}" Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time (Lagos)" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLagos}}" Width="1.3*" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.3*" />
                        <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="0.9*" />
                        <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="1*" />
                        <DataGridTemplateColumn Header="Outcome" Width="0.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PillBorder}" Background="{StaticResource MutedSoftBrush}">
                                        <TextBlock Text="{Binding Outcome, Converter={StaticResource SpacedEnum}}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Success">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Failure">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Outcome}" Value="Denied">
                                                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Details" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="24"
                            Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                    <TextBlock Text="No audit entries match these filters" Style="{StaticResource EmptyStateTitle}" />
                    <TextBlock Text="Change the date range or clear the action/outcome filters." Style="{StaticResource EmptyStateBody}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding PageText}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Previous" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
                        <Button Content="Next" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
