<UserControl x:Class="GasGuard.Desktop.Views.IncidentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Incident History" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Paged, filterable history with original SMS inspection, acknowledgement and resolution evidence. Raw device readings are not calibrated ppm." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,4,0,0">
                <Button Content="Export filtered CSV" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" />
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource InsetBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Device, name or location" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="From (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FromDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="To (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ToDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Text="Severity" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="8">
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock Text="Location contains" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding LocationText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock Text="Detector" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                    <Button Content="Reset" Style="{StaticResource GhostButton}" Command="{Binding ResetFiltersCommand}" />
                    <Button Content="Apply filters" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding ApplyFiltersCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedIncident}"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="0.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PillBorder}" Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=background}">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource StateText}}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detector" Binding="{Binding DeviceCode}" Width="0.8*" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.5*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource IncidentStatusText}}" Width="1*" />
                            <DataGridTextColumn Header="Received (Lagos)" Binding="{Binding ReceivedAtUtc, Converter={StaticResource UtcToLagos}}" Width="1.4*" />
                            <DataGridTemplateColumn Header="Demo" Width="0.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"
                                                   Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                        <TextBlock Text="No incidents match these filters" Style="{StaticResource EmptyStateTitle}" />
                        <TextBlock Text="Widen the date range or clear a filter. Absence of records is not evidence that no hazard occurred." Style="{StaticResource EmptyStateBody}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Previous" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
                            <Button Content="Next" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDetails.Summary.DeviceCode}" Style="{StaticResource SectionTitle}" FontSize="18" />
                            <TextBlock Text="{Binding SelectedDetails.Summary.DeviceName}" Style="{StaticResource MutedText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource PillBorder}" Background="{Binding SelectedDetails.Summary.Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=background}">
                                    <TextBlock Text="{Binding SelectedDetails.Summary.Severity, Converter={StaticResource StateText}}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding SelectedDetails.Summary.Severity, Converter={StaticResource SeverityBrush}}" />
                                </Border>
                                <Border Style="{StaticResource PillBorder}" Margin="6,0,0,0" Background="{Binding SelectedDetails.Summary.Status, Converter={StaticResource IncidentStatusBrush}, ConverterParameter=background}">
                                    <TextBlock Text="{Binding SelectedDetails.Summary.Status, Converter={StaticResource IncidentStatusText}}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding SelectedDetails.Summary.Status, Converter={StaticResource IncidentStatusBrush}}" />
                                </Border>
                                <Border Style="{StaticResource PillBorder}" Margin="6,0,0,0" Background="{StaticResource InfoSoftBrush}"
                                        Visibility="{Binding SelectedDetails.Summary.IsSimulated, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="SIMULATED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,9">
                                    <TextBlock Text="Location" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.Location}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,9">
                                    <TextBlock Text="Occurred (Lagos)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.OccurredAtUtc, Converter={StaticResource UtcToLagos}}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,9">
                                    <TextBlock Text="Received (Lagos)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.ReceivedAtUtc, Converter={StaticResource UtcToLagos}}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,9">
                                    <TextBlock Text="Time source" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.OccurredTimeSource, Converter={StaticResource SpacedEnum}}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,9">
                                    <TextBlock Text="Raw reading" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.Reading}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,9">
                                    <TextBlock Text="Sequence" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SelectedDetails.Summary.SequenceNumber}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Acknowledgement" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedDetails.AcknowledgedBy, TargetNullValue=Not acknowledged}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedDetails.AcknowledgementNotes}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                            <TextBlock Text="Resolution" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding SelectedDetails.ResolvedBy, TargetNullValue=Not resolved}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedDetails.ResolutionNotes}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />

                            <Border Style="{StaticResource InsetBorder}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Original SMS" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedDetails.RawSmsBody}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="68" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="History" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding TimestampUtc, Converter={StaticResource UtcToLagos}}" HorizontalAlignment="Right" Style="{StaticResource SubtleText}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" Margin="24"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                        <TextBlock Text="Select an incident" Style="{StaticResource EmptyStateTitle}" />
                        <TextBlock Text="Full timestamp, original SMS, acknowledgement and resolution evidence will appear here." Style="{StaticResource EmptyStateBody}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
