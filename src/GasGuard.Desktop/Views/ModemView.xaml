<UserControl x:Class="GasGuard.Desktop.Views.ModemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GSM Modem" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Serial port configuration, SIM/network readiness, SMS mode, reconciliation and diagnostics. A modem connection does not prove that a detector is online." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,4,0,0">
                <Button Content="Refresh status" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshStatusCommand}" />
                <Button Content="Poll now" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding PollNowCommand}" />
                <Button Content="Refresh COM ports" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Command="{Binding RefreshPortsCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Connection settings" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="USB GSM modems use different AT command support. Verify the chosen port and SIM on the intended Nigerian network before operational use."
                                       Style="{StaticResource SubtleText}" Margin="0,4,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ModemModes}" SelectedItem="{Binding SelectedModemMode}" DisplayMemberPath="Label" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Serial port" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPhysicalMode}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                    <TextBlock Text="Detected serial ports (selection fills the port field)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedDetectedPort}" IsEnabled="{Binding IsPhysicalMode}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Baud rate" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Data bits" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DataBitsText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="Parity" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Parities}" SelectedItem="{Binding SelectedParity}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SpacedEnum}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="Stop bits" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBits}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SpacedEnum}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Handshake" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding SelectedHandshake}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource SpacedEnum}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="SMS polling interval (seconds)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PollIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="AT command timeout (milliseconds)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CommandTimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <CheckBox Content="Auto-connect on application start" IsChecked="{Binding AutoConnect}" Margin="0,4,0,0" />
                            <CheckBox Content="Automatically attempt physical modem reconnection after a fault (bounded)" IsChecked="{Binding AutoReconnect}" Margin="0,4,0,0" />
                            <CheckBox Content="Delete SMS from modem storage only after successful database persistence" IsChecked="{Binding DeleteSmsAfterPersistence}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,8,0,0"
                                       Text="The delete setting is a safety default. If persistence fails, the message is retained in modem storage for reconciliation." />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Save settings" Style="{StaticResource SecondaryButton}" Command="{Binding SaveSettingsCommand}" />
                                <Button Content="Connect modem" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding ConnectCommand}" />
                                <Button Content="Disconnect" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding DisconnectCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Modem status" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ModemIdentityText}" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Border Style="{StaticResource PillBorder}" Background="{StaticResource InfoSoftBrush}"
                                            Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="SIMULATED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource InsetBorder}" Margin="0,12,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ConnectionHeadline}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource SubtleText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PillBorder}" Background="{Binding ConnectionState, Converter={StaticResource StateBrush}, ConverterParameter=background}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ConnectionState, Converter={StaticResource SpacedEnum}}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding ConnectionState, Converter={StaticResource StateBrush}}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIM" Style="{StaticResource FieldLabel}" Margin="0,0,14,7" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SimStatusText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="1" Text="Network" Style="{StaticResource FieldLabel}" Margin="0,0,14,7" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RegistrationText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="2" Text="Operator" Style="{StaticResource FieldLabel}" Margin="0,0,14,7" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OperatorText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="3" Text="Signal" Style="{StaticResource FieldLabel}" Margin="0,0,14,7" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SignalText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="4" Text="Text mode" Style="{StaticResource FieldLabel}" Margin="0,0,14,7" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TextModeText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="5" Text="Indication" Style="{StaticResource FieldLabel}" Margin="0,0,14,7" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding NewMessageText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="6" Text="Last poll" Style="{StaticResource FieldLabel}" Margin="0,0,14,7" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastPollText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="7" Text="Sim. storage" Style="{StaticResource FieldLabel}" Margin="0,0,14,0" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PendingStoredText}" TextWrapping="Wrap" />
                            </Grid>

                            <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                           Text="A connected modem is not proof that detectors are online. Detector freshness is shown separately on the dashboard." />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Simulator controls" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Only available in simulated modem mode. Every generated message is labelled SIMULATED and is never a live gas measurement."
                                           Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Content="Load demo detectors &amp; contacts" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding LoadDemoDataCommand}" />
                        </Grid>

                        <Grid Margin="0,12,0,0" Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource InsetBorder}">
                                <StackPanel>
                                    <TextBlock Text="Inject structured demo message" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Detector" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{Binding DemoDevices}" SelectedItem="{Binding SelectedDemoDevice}" DisplayMemberPath="DeviceCode" />
                                    <TextBlock Text="Event" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{Binding DemoEvents}" SelectedItem="{Binding SelectedDemoEvent}" DisplayMemberPath="Label" />
                                    <TextBlock Text="Raw reading" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding DemoReadingText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Inject demo message" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Command="{Binding InjectDemoCommand}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource InsetBorder}">
                                <StackPanel>
                                    <TextBlock Text="Inject custom raw SMS" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Sender" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding CustomSender, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Raw body (malformed bodies are allowed for testing)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding CustomBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="80" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                    <TextBlock Text="Delivery delay (ms)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding CustomDelayText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Inject custom SMS" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Command="{Binding InjectCustomCommand}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource InsetBorder}">
                                <StackPanel>
                                    <TextBlock Text="Outgoing simulation &amp; faults" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="Outgoing SMS outcome" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{Binding SimulatedSendModes}" SelectedItem="{Binding SelectedSendMode}" DisplayMemberPath="Label" />
                                    <Button Content="Apply outcome mode" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Command="{Binding ApplySendModeCommand}" />
                                    <Button Content="Simulate modem disconnection" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Command="{Binding SimulateDisconnectCommand}" />
                                    <TextBlock Style="{StaticResource SubtleText}" Margin="0,10,0,0"
                                               Text="Reconnect with Connect modem. Unread simulated messages remain in simulated storage until they are successfully persisted." />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Simulator controls are hidden because the active modem is physical."
                                   Style="{StaticResource SubtleText}" Margin="0,12,0,0"
                                   Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Recent SMS evidence" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="All retained SMS, including invalid, unknown-device and unauthorised-sender messages. Invalid evidence never creates a trusted reading or incident."
                                           Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Content="Refresh SMS evidence" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding RefreshSmsEvidenceCommand}" />
                        </Grid>
                        <DataGrid Margin="0,10,0,0" Height="210" ItemsSource="{Binding SmsEvidence}" SelectedItem="{Binding SelectedSmsEvidence}"
                                  Visibility="{Binding HasSmsEvidence, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Received (Lagos)" Binding="{Binding ReceivedAtUtc, Converter={StaticResource UtcToLagos}}" Width="1.3*" />
                                <DataGridTextColumn Header="Sender" Binding="{Binding SenderNumberRaw}" Width="1.1*" />
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceCode}" Width="0.8*" />
                                <DataGridTextColumn Header="Processing" Binding="{Binding ProcessingStatus, Converter={StaticResource SpacedEnum}}" Width="1.1*" />
                                <DataGridTextColumn Header="Event" Binding="{Binding EventCode, Converter={StaticResource SpacedEnum}}" Width="0.9*" />
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity, Converter={StaticResource StateText}}" Width="0.8*" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding ProcessingDetail}" Width="2*" />
                                <DataGridTemplateColumn Header="Demo" Width="0.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"
                                                       Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No SMS evidence retained yet" Style="{StaticResource EmptyStateBody}" Margin="0,18"
                                   Visibility="{Binding HasSmsEvidence, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                        <Border Style="{StaticResource InsetBorder}" Margin="0,10,0,0"
                                Visibility="{Binding SelectedSmsEvidence, Converter={StaticResource NullToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Selected raw SMS (preserved exactly as received)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SelectedSmsEvidence.BodyRaw, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="74" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                                <TextBlock Text="{Binding SelectedSmsEvidence.ProcessingDetail}" Style="{StaticResource SubtleText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,14,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Modem diagnostics (current session)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="In-memory commands and faults. Persistent communication history is kept in the database and shown on the dashboard."
                                           Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshDiagnosticsCommand}" />
                                <Button Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearDiagnosticsCommand}" />
                            </StackPanel>
                        </Grid>
                        <DataGrid Margin="0,10,0,0" Height="210" ItemsSource="{Binding Diagnostics}"
                                  Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time (Lagos)" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLagos}}" Width="1.2*" />
                                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="0.7*" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Text}" Width="3*" />
                                <DataGridTemplateColumn Header="Error" Width="0.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="ERROR" Foreground="{StaticResource CriticalBrush}" FontSize="10" FontWeight="Bold"
                                                       Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="No diagnostics in this session" Style="{StaticResource EmptyStateBody}" Margin="0,18"
                                   Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
