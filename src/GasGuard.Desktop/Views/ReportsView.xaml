<UserControl x:Class="GasGuard.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Reports &amp; Analytics" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Incident counts, detector activity and communication-failure summaries for a selected period. Raw readings remain device values, not calibrated ppm." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,4,0,0">
                <Button Content="Generate report" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" />
                <Button Content="Incidents CSV" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ExportIncidentsCommand}" />
                <Button Content="Communication CSV" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ExportCommunicationCommand}" />
                <Button Content="Activity CSV" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ExportActivityCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource InsetBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="From (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FromDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="To (yyyy-MM-dd)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ToDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Detector" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Severity" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" DisplayMemberPath="Label" />
                </StackPanel>
                <CheckBox Grid.Column="7" Content="Include simulated data" IsChecked="{Binding IncludeSimulated}" VerticalAlignment="Bottom" Margin="14,0,0,7" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="5" Margin="0,0,-12,4">
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="INCIDENTS" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding TotalIncidents}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="CRITICAL" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding CriticalIncidentCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource CriticalBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="WARNING" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding WarningIncidentCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="SIMULATED" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding SimulatedIncidents}" Style="{StaticResource MetricValue}" Foreground="{StaticResource InfoBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="COMM FAILURES" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding CommunicationFailureCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,12">
                    <TextBlock Text="{Binding GeneratedText}" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Incident trend by local day" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Bars show counts. No chart is rendered from unverified data." Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                            <ItemsControl ItemsSource="{Binding Trend}" Margin="0,12,0,0" Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="252" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Critical}" FontSize="11" Foreground="{StaticResource CriticalBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Warning}" FontSize="11" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                                            <Grid Grid.Column="3" Height="14" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Height="14" Fill="{StaticResource CriticalBrush}" Width="{Binding CriticalWidth}" />
                                                    <Rectangle Height="14" Fill="{StaticResource WarningBrush}" Width="{Binding WarningWidth}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Grid.Column="4" Text="{Binding Total}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="0,18,0,14" Visibility="{Binding HasTrend, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                                <TextBlock Text="No incidents in this period" Style="{StaticResource EmptyStateTitle}" />
                                <TextBlock Text="Try a wider date range. A trend with no points is not evidence of safe conditions." Style="{StaticResource EmptyStateBody}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Incidents by detector" Style="{StaticResource SectionTitle}" />
                            <DataGrid Margin="0,10,0,0" Height="230" ItemsSource="{Binding DeviceCounts}"
                                      Visibility="{Binding HasDeviceCounts, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Detector" Binding="{Binding DeviceCode}" Width="0.9*" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.5*" />
                                    <DataGridTextColumn Header="Critical" Binding="{Binding CriticalCount}" Width="0.7*" />
                                    <DataGridTextColumn Header="Warning" Binding="{Binding WarningCount}" Width="0.7*" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding IncidentCount}" Width="0.6*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No detector incidents in this period" Style="{StaticResource EmptyStateBody}" Margin="0,18"
                                       Visibility="{Binding HasDeviceCounts, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,14,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Communication failures" Style="{StaticResource SectionTitle}" />
                            <DataGrid Margin="0,10,0,0" Height="210" ItemsSource="{Binding CommunicationFailures}"
                                      Visibility="{Binding HasCommunicationFailures, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Converter={StaticResource SpacedEnum}}" Width="1*" />
                                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome, Converter={StaticResource SpacedEnum}}" Width="0.9*" />
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="0.6*" />
                                    <DataGridTextColumn Header="Last (Lagos)" Binding="{Binding LastOccurrenceUtc, Converter={StaticResource UtcToLagos}}" Width="1.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No communication failures in this period" Style="{StaticResource EmptyStateBody}" Margin="0,18"
                                       Visibility="{Binding HasCommunicationFailures, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Detector activity" Style="{StaticResource SectionTitle}" />
                            <DataGrid Margin="0,10,0,0" Height="210" ItemsSource="{Binding DetectorActivity}"
                                      Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Detector" Binding="{Binding DeviceCode}" Width="0.9*" />
                                    <DataGridTextColumn Header="Messages" Binding="{Binding ProcessedMessageCount}" Width="0.8*" />
                                    <DataGridTextColumn Header="Failed" Binding="{Binding FailedMessageCount}" Width="0.7*" />
                                    <DataGridTextColumn Header="Incidents" Binding="{Binding IncidentCount}" Width="0.8*" />
                                    <DataGridTextColumn Header="Last success (Lagos)" Binding="{Binding LastSuccessfulCommunicationUtc, Converter={StaticResource UtcToLagos}}" Width="1.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No detector activity data" Style="{StaticResource EmptyStateBody}" Margin="0,18"
                                       Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
