<UserControl x:Class="GasGuard.Desktop.Views.DetectorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Gas Detectors" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Registry of detector identity, expected SMS sender and installation location. Deactivation preserves every historical incident." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,4,0,0">
                <Button Content="Add detector" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding EditCommand}"
                        IsEnabled="{Binding HasSelection}" />
                <Button Content="{Binding ToggleActiveText}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource InsetBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Search detectors" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by code, name, location or expected sender" />
                </StackPanel>
                <CheckBox Grid.Column="2" Content="Include inactive detectors" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                <TextBlock Grid.Column="3" Text="{Binding FilteredCountText}" Style="{StaticResource SubtleText}" VerticalAlignment="Bottom" Margin="12,0,2,8" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Detector" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DeviceCode}" FontWeight="SemiBold" />
                                            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="3" Padding="5,0" Margin="7,0,0,0"
                                                    Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="DEMO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubtleText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Location" Binding="{Binding InstallationLocation}" Width="1.6*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding DetectorType, Converter={StaticResource SpacedEnum}}" Width="1.1*" />
                        <DataGridTextColumn Header="Expected sender" Binding="{Binding ExpectedSenderNumber}" Width="1.1*" />
                        <DataGridTemplateColumn Header="Status" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource PillBorder}" Background="{Binding OperationalState, Converter={StaticResource StateBrush}, ConverterParameter=background}">
                                            <TextBlock Text="{Binding OperationalState, Converter={StaticResource StateText}}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding OperationalState, Converter={StaticResource StateBrush}}" />
                                        </Border>
                                        <TextBlock Text="INACTIVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last report (Lagos)" Binding="{Binding LastSuccessfulCommunicationUtc, Converter={StaticResource UtcToLagos}}" Width="1.4*" />
                        <DataGridTextColumn Header="Age" Binding="{Binding LastSuccessfulCommunicationUtc, Converter={StaticResource UtcAge}}" Width="0.8*" />
                        <DataGridTextColumn Header="Raw reading" Binding="{Binding LastReading}" Width="0.8*" />
                        <DataGridTextColumn Header="Seq" Binding="{Binding LastSequenceNumber}" Width="0.6*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel VerticalAlignment="Center" Margin="24"
                            Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                    <TextBlock Text="No detectors in this view" Style="{StaticResource EmptyStateTitle}" />
                    <TextBlock Style="{StaticResource EmptyStateBody}"
                               Text="Create a detector with its unique device code and expected sender number. Inactive detectors are hidden unless the filter is enabled." />
                    <Button Content="Add detector" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Command="{Binding AddCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
