<UserControl x:Class="GasGuard.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings &amp; Maintenance" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,4,0,0"
                           Text="Application preferences, database health, verified backups, retention and protocol information. Modem connection settings are in the GSM Modem workspace." />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh health" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="18,4,0,0"
                    Command="{Binding RefreshHealthCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Application preferences" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="The freshness threshold controls when a detector last report is treated as stale/offline." Style="{StaticResource SubtleText}" Margin="0,3,0,12" />
                            <TextBlock Text="Stale data threshold (minutes)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StaleAfterText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Retention period (days; 0 disables cleanup)" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                            <TextBox Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Minimum diagnostic log level" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLogLevel}" />
                            <CheckBox Content="Enable automatic contact notifications for incidents" IsChecked="{Binding AutomaticNotifications}" Margin="0,12,0,0" />
                            <TextBlock Text="Notification attempts per contact (1-3)" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                            <TextBox Text="{Binding NotificationAttemptsText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Save preferences" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Command="{Binding SavePreferencesCommand}" />
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,10,0,0"
                                       Text="Automatic SMS notifications are submitted only when enabled, are bounded to 1-3 attempts, and never claim recipient delivery. Simulated incidents never trigger real SMS notifications." />
                            <Border Style="{StaticResource InsetBorder}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Modem configuration" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ModemSummary}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Database health" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource PillBorder}" HorizontalAlignment="Right"
                                        Background="{Binding DatabaseHealthy, Converter={StaticResource BoolToHealthyBrush}, ConverterParameter=background}">
                                    <TextBlock Text="{Binding DatabaseHealthy, Converter={StaticResource BoolToHealthyText}}"
                                               Foreground="{Binding DatabaseHealthy, Converter={StaticResource BoolToHealthyBrush}}"
                                               FontSize="10" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding DatabaseHealthText}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DatabaseSizeText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Integrity" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DatabaseIntegrityText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="Foreign keys" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ForeignKeysText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                    <TextBlock Text="Checked (Lagos)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding HealthCheckedText}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                    <TextBlock Text="Database path" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding DatabasePath}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource SubtleText}" Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Create verified backup" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" />
                                <Button Content="Open data folder" Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" />
                                <Button Content="Open backup folder" Style="{StaticResource GhostButton}" Command="{Binding OpenBackupsFolderCommand}" />
                                <Button Content="Open log folder" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsFolderCommand}" />
                            </StackPanel>

                            <TextBlock Text="Verified backups" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                            <DataGrid Height="160" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                                      Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                                    <DataGridTextColumn Header="Created (Lagos)" Binding="{Binding CreatedAtUtc, Converter={StaticResource UtcToLagos}}" Width="1.4*" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToSize}}" Width="0.7*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No backups in the backup folder" Style="{StaticResource EmptyStateBody}" Margin="0,12"
                                       Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}" />
                            <TextBlock Text="{Binding BackupValidationText}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Validate selected" Style="{StaticResource SecondaryButton}" Command="{Binding ValidateSelectedBackupCommand}"
                                        IsEnabled="{Binding HasSelectedBackup}" />
                                <Button Content="Restore selected" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding RestoreSelectedCommand}"
                                        IsEnabled="{Binding HasSelectedBackup}" />
                                <Button Content="Restore from file" Style="{StaticResource GhostButton}" Command="{Binding RestoreFromFileCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,8,0,0"
                                       Text="A restore is validated, creates a pre-restore safety backup, and requires an application restart. Backups are verified with SQLite integrity and foreign-key checks." />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,14,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Retention &amp; maintenance" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,10"
                                       Text="Retention cleanup uses the saved retention period. It never deletes incidents or SMS records linked to incidents." />
                            <Button Content="Run retention cleanup now" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                    Command="{Binding RunRetentionCommand}" />
                            <TextBlock Text="Protocol settings" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                            <TextBlock Text="{Binding ProtocolVersion, StringFormat=Protocol version: {0}}" />
                            <TextBlock Text="{Binding SupportedEvents, StringFormat=Supported events: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SupportedLevels, StringFormat=Supported levels: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding TimeZoneName, StringFormat=Display time zone: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="About GasGuard Desktop" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                                GasGuard Desktop receives SMS telemetry through a USB GSM modem, validates the protocol,
                                preserves raw messages and incident evidence, and supports operator acknowledgement and
                                explicit resolution. It is an academic monitoring and demonstration system.
                            </TextBlock>
                            <Border Background="{StaticResource CriticalSoftBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                <TextBlock Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap">
                                    The detector and its local alarm must operate independently of Windows, the database,
                                    the USB modem, SMS and all network services. This desktop application is not a safety
                                    controller and never clears or deactivates a local gas alarm.
                                </TextBlock>
                            </Border>
                            <TextBlock Style="{StaticResource SubtleText}" Margin="0,12,0,0"
                                       Text="Raw ADC values are not presented as calibrated gas concentrations. Verify detectors and gas response with appropriate engineering controls; never test with uncontrolled gas or naked flames." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
